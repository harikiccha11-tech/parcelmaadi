// ParcelMaadi - Prisma schema
// Admin Panel is master. Customer website reads live data from database.
// For production (Vercel): set DATABASE_URL to PostgreSQL connection string.
// For local dev: set DATABASE_URL to SQLite file path (provider auto-detected).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Settings {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String?
  type      String   @default("text")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model DomainSettings {
  id                 Int      @id @default(autoincrement())
  customerUrl        String?  @map("customer_url")
  adminUrl           String?  @map("admin_url")
  apiBaseUrl         String?  @map("api_base_url")
  canonicalUrl       String?  @map("canonical_url")
  whatsappBookingUrl String?  @map("whatsapp_booking_url")
  logoUrl            String?  @map("logo_url")
  imageBaseUrl       String?  @map("image_base_url")
  sitemapUrl         String?  @map("sitemap_url")
  robotsSettings     String?  @map("robots_settings")
  seoTitle           String?  @map("seo_title")
  seoDescription     String?  @map("seo_description")
  updatedAt          DateTime @updatedAt @map("updated_at")
}

model Service {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?   @map("image_url")
  icon        String?
  status      String    @default("Active")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  vehicles    Vehicle[]
  priceMaster PriceMaster[]
  bookings    Booking[]
}

model Vehicle {
  id              Int           @id @default(autoincrement())
  serviceId       Int           @map("service_id")
  service         Service       @relation(fields: [serviceId], references: [id])
  name            String
  slug            String?
  maxLoad         String?       @map("max_load")
  imageUrl        String?       @map("image_url")
  recommendedUse  String?       @map("recommended_use")
  status          String        @default("Active")
  sortOrder       Int           @default(0) @map("sort_order")
  priceMaster     PriceMaster[]
  bookings        Booking[]
}

model PriceMaster {
  id                  Int      @id @default(autoincrement())
  serviceId           Int      @map("service_id")
  service             Service  @relation(fields: [serviceId], references: [id])
  vehicleId           Int?     @map("vehicle_id")
  vehicle             Vehicle? @relation(fields: [vehicleId], references: [id])
  supplierId          Int?     @map("supplier_id")
  supplier            Supplier? @relation(fields: [supplierId], references: [id])
  zoneId              Int?     @map("zone_id")
  zone                Zone?    @relation(fields: [zoneId], references: [id])
  itemType            String?  @map("item_type")
  pricingType         String   @default("standard") @map("pricing_type")
  unitType            String?  @map("unit_type")
  perUnitRate         Float    @default(0) @map("per_unit_rate")
  minimumKm           Float    @default(0) @map("minimum_km")
  freeKm              Float    @default(0) @map("free_km")
  minimumFare         Float    @default(0) @map("minimum_fare")
  perKmRate           Float    @default(0) @map("per_km_rate")
  extraKmRate         Float    @default(0) @map("extra_km_rate")
  slabJson            String   @default("[]") @map("slab_json")
  loadingCharge       Float    @default(0) @map("loading_charge")
  unloadingCharge     Float    @default(0) @map("unloading_charge")
  waitingCharge       Float    @default(0) @map("waiting_charge")
  helperCharge        Float    @default(0) @map("helper_charge")
  labourCharge        Float    @default(0) @map("labour_charge")
  tollCharge          Float    @default(0) @map("toll_charge")
  parkingCharge       Float    @default(0) @map("parking_charge")
  nightChargePercent  Float    @default(0) @map("night_charge_percent")
  expressChargePercent Float   @default(0) @map("express_charge_percent")
  // surge charges (%)
  peakSurchargePercent Float   @default(0) @map("peak_surcharge_percent")
  rainSurchargePercent Float   @default(0) @map("rain_surcharge_percent")
  demandSurchargePercent Float @default(0) @map("demand_surcharge_percent")
  // machinery-specific
  operatorCharge      Float    @default(0) @map("operator_charge")
  fuelCharge          Float    @default(0) @map("fuel_charge")
  mobilizationCharge  Float    @default(0) @map("mobilization_charge")
  demobilizationCharge Float   @default(0) @map("demobilization_charge")
  minimumHours        Float    @default(0) @map("minimum_hours")
  extraHourRate       Float    @default(0) @map("extra_hour_rate")
  // water-specific
  refillCharge        Float    @default(0) @map("refill_charge")
  // outstation-specific
  driverAllowance     Float    @default(0) @map("driver_allowance")
  nightHaltCharge     Float    @default(0) @map("night_halt_charge")
  stateTax            Float    @default(0) @map("state_tax")
  extraDayRate        Float    @default(0) @map("extra_day_rate")
  // shop-specific
  platformFee         Float    @default(0) @map("platform_fee")
  deliveryFee         Float    @default(0) @map("delivery_fee")
  extraCharge         Float    @default(0) @map("extra_charge")
  discountPercent     Float    @default(0) @map("discount_percent")
  gstPercent          Float    @default(0) @map("gst_percent")
  advancePercent      Float    @default(0) @map("advance_percent")
  minimumBooking      Float    @default(0) @map("minimum_booking")
  commissionPercent   Float    @default(0) @map("commission_percent")
  roundTripMultiplier Float    @default(1.8) @map("round_trip_multiplier")
  rushSurchargePercent Float   @default(0) @map("rush_surcharge_percent")
  notes               String?
  status              String   @default("Active")
  updatedAt           DateTime @updatedAt @map("updated_at")
}

model Zone {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?
  pinCodes    String?  @map("pin_codes")
  cities      String?
  status      String   @default("Active")
  createdAt   DateTime @default(now()) @map("created_at")
  priceMaster PriceMaster[]
  zoneAvailabilities ZoneAvailability[]
}

model Coupon {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  description  String?
  discountType String   @default("percent")
  discountValue Float   @default(0)
  minOrderAmount Float  @default(0) @map("min_order_amount")
  maxDiscount  Float    @default(0) @map("max_discount")
  usageLimit   Int      @default(0) @map("usage_limit")
  usedCount    Int      @default(0) @map("used_count")
  validFrom    DateTime? @map("valid_from")
  validUntil   DateTime? @map("valid_until")
  status       String   @default("Active")
  createdAt    DateTime @default(now()) @map("created_at")
}

model Customer {
  id        Int       @id @default(autoincrement())
  name      String
  mobile    String
  email     String?
  createdAt DateTime  @default(now()) @map("created_at")
  bookings  Booking[]

  @@index([mobile])
  @@index([createdAt])
}

model Booking {
  id                   Int            @id @default(autoincrement())
  bookingId            String         @unique @map("booking_id")
  customerId           Int            @map("customer_id")
  customer             Customer       @relation(fields: [customerId], references: [id])
  serviceId            Int            @map("service_id")
  service              Service        @relation(fields: [serviceId], references: [id])
  vehicleId            Int?           @map("vehicle_id")
  vehicle              Vehicle?       @relation(fields: [vehicleId], references: [id])
  supplierId           Int?           @map("supplier_id")
  supplier             Supplier?      @relation(fields: [supplierId], references: [id])
  riderId              Int?           @map("rider_id")
  rider                Rider?         @relation("RiderBookings", fields: [riderId], references: [id])
  otp                  String?
  pickupAddress        String?        @map("pickup_address")
  pickupLat            Float?         @map("pickup_lat")
  pickupLng            Float?         @map("pickup_lng")
  pickupMapLink        String?        @map("pickup_map_link")
  dropAddress          String?        @map("drop_address")
  dropLat              Float?         @map("drop_lat")
  dropLng              Float?         @map("drop_lng")
  dropMapLink          String?        @map("drop_map_link")
  distanceKm           Float?         @map("distance_km")
  distanceMethod       String?        @map("distance_method")
  scheduleDate         String?        @map("schedule_date")
  scheduleTime         String?        @map("schedule_time")
  itemDetails          String?        @map("item_details")
  weight               String?
  quantity             String?
  // per-service-type extras
  tripType             String?        @map("trip_type")
  durationHours        Float?         @map("duration_hours")
  durationDays         Float?         @map("duration_days")
  unitType             String?        @map("unit_type")
  unitQuantity         Float?         @map("unit_quantity")
  materialCost         Float?         @map("material_cost")
  deliveryCharge       Float?         @map("delivery_charge")
  rushSurchargeApplied Float?         @map("rush_surcharge_applied")
  isEmergency          Boolean        @default(false) @map("is_emergency")
  zoneId               Int?           @map("zone_id")
  couponCode           String?        @map("coupon_code")
  couponDiscount       Float          @default(0) @map("coupon_discount")
  surgeApplied         Float          @default(0) @map("surge_applied")
  photoUrl             String?        @map("photo_url")
  fileName             String?        @map("file_name")
  fileType             String?        @map("file_type")
  landmark             String?
  etaText              String?        @map("eta_text")
  fareSnapshotJson     String         @default("{}") @map("fare_snapshot_json")
  finalEstimate        Float          @default(0) @map("final_estimate")
  discountApplied      Float          @default(0) @map("discount_applied")
  adminFinalAmount     Float?         @map("admin_final_amount")
  paymentOption        String?        @map("payment_option")
  paymentStatus        String         @default("Pending") @map("payment_status")
  paymentReceived      Float          @default(0) @map("payment_received")
  paymentScreenshotUrl String?        @map("payment_screenshot_url")
  status               String         @default("New")
  driverName           String?        @map("driver_name")
  driverMobile         String?        @map("driver_mobile")
  driverType           String?        @map("driver_type")
  adminNotes           String?        @map("admin_notes")
  customerNotes        String?        @map("customer_notes")
  createdByIp          String?        @map("created_by_ip")
  createdAt            DateTime       @default(now()) @map("created_at")
  statusHistory        StatusHistory[]
  payments             Payment[]

  @@index([status])
  @@index([createdAt])
  @@index([customerId])
  @@index([serviceId])
  @@index([supplierId])
  @@index([riderId])
  @@index([isEmergency])
  @@index([bookingId])
}

model Supplier {
  id                Int       @id @default(autoincrement())
  supplierName      String    @map("supplier_name")
  shopName          String?   @map("shop_name")
  mobile            String?
  whatsapp          String?
  address           String?
  addressLat        Float?    @map("address_lat")
  addressLng        Float?    @map("address_lng")
  addressMapLink    String?   @map("address_map_link")
  flatDeliveryFee   Float     @default(0) @map("flat_delivery_fee")
  mapLocation       String?   @map("map_location")
  supplierType      String?   @map("supplier_type")
  aadhaarUrl        String?   @map("aadhaar_url")
  panUrl            String?   @map("pan_url")
  gstUrl            String?   @map("gst_url")
  udyamUrl          String?   @map("udyam_url")
  fssaiUrl          String?   @map("fssai_url")
  bankDetails       String?   @map("bank_details")
  upiId             String?   @map("upi_id")
  qrUrl             String?   @map("qr_url")
  shopPhotoUrl      String?   @map("shop_photo_url")
  serviceArea       String?   @map("service_area")
  commissionPercent Float     @default(0) @map("commission_percent")
  status            String    @default("Pending")
  createdAt         DateTime  @default(now()) @map("created_at")
  products          Product[]
  priceMaster       PriceMaster[]
  bookings          Booking[]

  @@index([status])
  @@index([supplierType])
}

model Product {
  id                  Int       @id @default(autoincrement())
  supplierId          Int       @map("supplier_id")
  supplier            Supplier  @relation(fields: [supplierId], references: [id])
  category            String?
  subcategory         String?   @map("subcategory")
  productName         String    @map("product_name")
  brand               String?
  packSize            String?   @map("pack_size")
  unit                String?   @map("unit")
  mrp                 Float     @default(0)
  marketLowPrice      Float     @default(0) @map("market_low_price")
  marketHighPrice     Float     @default(0) @map("market_high_price")
  supplierPrice       Float     @default(0) @map("supplier_price")
  sellingPrice        Float     @default(0) @map("selling_price")
  marginPercent       Float     @default(10) @map("margin_percent")
  gstPercent          Float     @default(5) @map("gst_percent")
  handlingFee         Float     @default(0) @map("handling_fee")
  priceSource         String?   @map("price_source")
  stock               Float     @default(0)
  expiryResponsibility String?  @map("expiry_responsibility")
  photoUrl            String?   @map("photo_url")
  status              String    @default("Pending")
  city                String?
  pincode             String?
  lastUpdated         DateTime? @map("last_updated")
  createdAt           DateTime  @default(now()) @map("created_at")

  @@index([supplierId])
  @@index([status])
  @@index([category])
  @@index([stock])
}

model Payment {
  id            Int       @id @default(autoincrement())
  bookingId     Int       @map("booking_id")
  booking       Booking   @relation(fields: [bookingId], references: [id])
  amount        Float     @default(0)
  paymentOption String?   @map("payment_option")
  paymentStatus String    @default("Pending") @map("payment_status")
  screenshotUrl String?   @map("screenshot_url")
  verifiedBy    String?   @map("verified_by")
  verifiedAt    DateTime? @map("verified_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([bookingId])
  @@index([paymentStatus])
  @@index([createdAt])
}

model AdminUser {
  id                  Int      @id @default(autoincrement())
  name                String?
  email               String   @unique
  mobile              String?
  passwordHash        String   @map("password_hash")
  role                String   @default("Owner")
  status              String   @default("Active")
  forcePasswordChange Boolean  @default(true) @map("force_password_change")
  createdAt           DateTime @default(now()) @map("created_at")

  // HR fields (nullable — existing admins have null)
  employeeId          String?  @unique @map("employee_id")
  designation         String?
  department          String?
  branch              String?
  reportingTo         String?  @map("reporting_to")
  joiningDate         DateTime? @map("joining_date")
  dateOfBirth         DateTime? @map("date_of_birth")
  gender              String?
  bloodGroup          String?  @map("blood_group")
  address             String?
  city                String?
  pincode             String?
  aadhaar             String?
  pan                 String?
  bankName            String?  @map("bank_name")
  bankAccount         String?  @map("bank_account")
  bankIfsc            String?  @map("bank_ifsc")
  upiId               String?  @map("upi_id")
  emergencyContact    String?  @map("emergency_contact")
  emergencyName       String?  @map("emergency_name")
  basicSalary         Float    @default(0) @map("basic_salary")
  hraAllowance        Float    @default(0) @map("hra_allowance")
  conveyanceAllowance Float    @default(0) @map("conveyance_allowance")
  specialAllowance    Float    @default(0) @map("special_allowance")
  pfNumber            String?  @map("pf_number")
  esiNumber           String?  @map("esi_number")
  shiftTiming         String?  @map("shift_timing")
  profilePhotoUrl     String?  @map("profile_photo_url")
  archived            Boolean  @default(false)

  resetTokens         PasswordReset[]
  activities          AdminActivity[]
  salaryPayments      SalaryPayment[]
  attendances         Attendance[]
  leaveRequests       LeaveRequest[]
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  adminId   Int      @map("admin_id")
  admin     AdminUser @relation(fields: [adminId], references: [id])
  token     String   @unique
  used      Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
}

model AdminActivity {
  id        Int      @id @default(autoincrement())
  adminId   Int?     @map("admin_id")
  admin     AdminUser? @relation(fields: [adminId], references: [id])
  action    String
  detail    String?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")
}

model StatusHistory {
  id        Int      @id @default(autoincrement())
  bookingId Int      @map("booking_id")
  booking   Booking  @relation(fields: [bookingId], references: [id])
  oldStatus String?  @map("old_status")
  newStatus String?  @map("new_status")
  changedBy String?  @map("changed_by")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
}

model SeoSetting {
  id           Int      @id @default(autoincrement())
  pageSlug     String   @unique @map("page_slug")
  title        String?
  description  String?
  canonicalUrl String?  @map("canonical_url")
  updatedAt    DateTime @updatedAt @map("updated_at")
}

model Waitlist {
  id          Int      @id @default(autoincrement())
  contact     String
  contactType String   @map("contact_type") // "email" | "phone"
  sourcePage  String?  @map("source_page")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([contact])
}

model ContentSection {
  id         Int      @id @default(autoincrement())
  sectionKey String   @unique @map("section_key")
  title      String?
  subtitle   String?
  body       String?
  imageUrl   String?  @map("image_url")
  status     String   @default("Active")
  sortOrder  Int      @default(0) @map("sort_order")
  updatedAt  DateTime @updatedAt @map("updated_at")
}


model Apk {
  id                Int      @id @default(autoincrement())
  name              String
  slug              String   @unique
  description       String?
  iconUrl           String?  @map("icon_url")
  downloadUrl       String?  @map("download_url")
  version           String?
  fileSize          String?  @map("file_size")
  developer         String?
  category          String?
  status            String   @default("Active")
  maintenanceMode   String   @default("Off") @map("maintenance_mode")
  maintenanceMsg    String?  @map("maintenance_msg")
  paymentType       String   @default("Free") @map("payment_type")
  upiId             String?  @map("upi_id")
  upiPayeeName      String?  @map("upi_payee_name")
  paymentAmount     Float    @default(0) @map("payment_amount")
  paymentCycle      String?  @map("payment_cycle")
  paymentNotes      String?  @map("payment_notes")
  qrUrl             String?  @map("qr_url")
  comingSoon        Boolean  @default(false) @map("coming_soon")
  comingSoonText    String?  @map("coming_soon_text")
  sortOrder         Int      @default(0) @map("sort_order")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
}

// =====================================================
// PREMIUM ADMIN PANEL — New models (additive, no breaking changes)
// =====================================================

model Rider {
  id              Int       @id @default(autoincrement())
  name            String
  mobile          String    @unique
  email           String?
  city            String?
  zoneId          Int?      @map("zone_id")
  vehicleType     String?   @map("vehicle_type")
  vehicleNumber   String?   @map("vehicle_number")
  drivingLicense  String?   @map("driving_license")
  aadhaar         String?
  address         String?
  photoUrl        String?   @map("photo_url")
  currentLat      Float?    @map("current_lat")
  currentLng      Float?    @map("current_lng")
  isOnline        Boolean   @default(false) @map("is_online")
  isVerified      Boolean   @default(false) @map("is_verified")
  rating          Float     @default(5)
  totalDeliveries Int       @default(0) @map("total_deliveries")
  totalEarnings   Float     @default(0) @map("total_earnings")
  status          String    @default("Active")
  archived        Boolean   @default(false)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  bookings        Booking[] @relation("RiderBookings")
  settlements     Settlement[]

  @@index([status])
  @@index([isOnline])
  @@index([mobile])
}

model Branch {
  id          Int      @id @default(autoincrement())
  name        String
  code        String   @unique
  address     String?
  city        String?
  pincode     String?
  mobile      String?
  email       String?
  managerName String?  @map("manager_name")
  managerMobile String? @map("manager_mobile")
  lat         Float?
  lng         Float?
  zoneId      Int?     @map("zone_id")
  status      String   @default("Active")
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  parentId    Int?     @map("parent_id")
  icon        String?
  imageUrl    String?  @map("image_url")
  sortOrder   Int      @default(0) @map("sort_order")
  status      String   @default("Active")
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
}

model Wallet {
  id           Int      @id @default(autoincrement())
  holderType   String   @map("holder_type") // "Customer" | "Rider" | "Vendor" | "Branch"
  holderId     Int      @map("holder_id")
  balance      Float    @default(0)
  currency     String   @default("INR")
  status       String   @default("Active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  transactions WalletTransaction[]

  @@unique([holderType, holderId])
}

model WalletTransaction {
  id          Int      @id @default(autoincrement())
  walletId    Int      @map("wallet_id")
  wallet      Wallet   @relation(fields: [walletId], references: [id])
  type        String   // "Credit" | "Debit"
  amount      Float
  description String?
  reference   String?  // booking_id / settlement_id / etc
  balanceAfter Float   @map("balance_after")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([walletId])
  @@index([createdAt])
}

model Settlement {
  id            Int      @id @default(autoincrement())
  riderId       Int?     @map("rider_id")
  rider         Rider?   @relation(fields: [riderId], references: [id])
  vendorId      Int?     @map("vendor_id")
  periodStart   DateTime @map("period_start")
  periodEnd     DateTime @map("period_end")
  totalRides    Int      @default(0) @map("total_rides")
  grossAmount   Float    @default(0) @map("gross_amount")
  commission    Float    @default(0)
  netAmount     Float    @default(0) @map("net_amount")
  status        String   @default("Pending") // "Pending" | "Approved" | "Paid" | "Cancelled"
  paidAt        DateTime? @map("paid_at")
  utr           String?  // bank UTR
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  adminId   Int?     @map("admin_id")
  adminEmail String? @map("admin_email")
  action    String
  module    String?
  entityId  Int?     @map("entity_id")
  entityType String? @map("entity_type")
  before    String?  // JSON snapshot
  after     String?  // JSON snapshot
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
}

model FeatureFlag {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  label       String?
  description String?
  enabled     Boolean  @default(false)
  rolloutPercent Int   @default(0) @map("rollout_percent")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")
}

model ApiKey {
  id          Int      @id @default(autoincrement())
  name        String
  keyPrefix   String   @map("key_prefix")
  hashedKey   String   @unique @map("hashed_key")
  scopes      String?  // CSV: "bookings:read,bookings:write,..."
  lastUsedAt  DateTime? @map("last_used_at")
  expiresAt   DateTime? @map("expires_at")
  createdBy   String?  @map("created_by")
  status      String   @default("Active")
  createdAt   DateTime @default(now()) @map("created_at")
}

model Integration {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  category    String?  // "Payment" | "SMS" | "Email" | "WhatsApp" | "Maps" | "Analytics"
  configJson  String   @default("{}") @map("config_json")
  status      String   @default("Inactive")
  notes       String?
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")
}

model Banner {
  id          Int      @id @default(autoincrement())
  title       String
  subtitle    String?
  imageUrl    String?  @map("image_url")
  linkUrl     String?  @map("link_url")
  position    String   @default("home_top") // home_top, home_mid, sidebar, etc
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  sortOrder   Int      @default(0) @map("sort_order")
  status      String   @default("Active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
}

model NotificationLog {
  id         Int      @id @default(autoincrement())
  channel    String   // "WhatsApp" | "SMS" | "Email" | "Push"
  recipient  String
  subject    String?
  body       String?
  status     String   @default("Sent") // Sent, Failed, Queued
  error      String?
  meta       String?  // JSON
  createdAt  DateTime @default(now()) @map("created_at")
}

model SupportTicket {
  id          Int      @id @default(autoincrement())
  subject     String
  description String?
  customerId  Int?     @map("customer_id")
  bookingId   String?  @map("booking_id")
  channel     String   @default("Web") // Web, WhatsApp, Email, App
  priority    String   @default("Medium") // Low, Medium, High, Urgent
  status      String   @default("Open") // Open, In Progress, Resolved, Closed
  assignedTo  String?  @map("assigned_to")
  resolution  String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
}

model City {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  state     String?
  code      String?
  lat       Float?
  lng       Float?
  status    String   @default("Active")
  archived  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model Offer {
  id           Int      @id @default(autoincrement())
  title        String
  description  String?
  offerType    String   @default("discount") // discount, cashback, free_delivery
  value        Float    @default(0)
  minOrderAmount Float  @default(0) @map("min_order_amount")
  maxDiscount  Float    @default(0) @map("max_discount")
  applicableServices String? @map("applicable_services") // CSV of service IDs
  startDate    DateTime? @map("start_date")
  endDate      DateTime? @map("end_date")
  usageLimit   Int      @default(0) @map("usage_limit")
  usedCount    Int      @default(0) @map("used_count")
  status       String   @default("Active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
}

// Add riderId to Booking via relation - we add a nullable riderId field
// (Prisma doesn't allow easy ALTER on existing models without losing data,
//  so we use a relation table approach via Rider.bookings)

// =====================================================
// PERFORMANCE INDEXES (for 20k+ records)
// =====================================================

// Indexes are added via @@index on existing models below as Prisma schema extensions

// =====================================================
// ZONE AVAILABILITY — control which services/vehicles/products are available per zone
// =====================================================

model ZoneAvailability {
  id          Int      @id @default(autoincrement())
  zoneId      Int      @map("zone_id")
  zone        Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  itemType    String   @map("item_type") // "Service" | "Vehicle" | "Product"
  itemId      Int      @map("item_id")
  available   Boolean  @default(true)
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([zoneId, itemType, itemId])
  @@index([zoneId, itemType])
}

// =====================================================
// HR / EMPLOYEE MANAGEMENT — staff, salary, attendance, leaves
// =====================================================

model SalaryPayment {
  id              Int       @id @default(autoincrement())
  staffId         Int       @map("staff_id")
  staff           AdminUser @relation(fields: [staffId], references: [id], onDelete: Cascade)
  month           Int       // 1-12
  year            Int
  basicSalary     Float     @default(0) @map("basic_salary")
  hra             Float     @default(0)
  conveyance      Float     @default(0)
  specialAllowance Float    @default(0) @map("special_allowance")
  bonus           Float     @default(0)
  deductions      Float     @default(0)
  pfDeduction     Float     @default(0) @map("pf_deduction")
  esiDeduction    Float     @default(0) @map("esi_deduction")
  taxDeduction    Float     @default(0) @map("tax_deduction")
  netAmount       Float     @default(0) @map("net_amount")
  daysPresent     Int       @default(0) @map("days_present")
  daysAbsent      Int       @default(0) @map("days_absent")
  daysInMonth     Int       @default(30) @map("days_in_month")
  status          String    @default("Pending") // Pending, Approved, Paid
  paidAt          DateTime? @map("paid_at")
  utr             String?   // bank UTR
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([staffId, month, year])
  @@index([staffId])
  @@index([status])
}

model Attendance {
  id          Int       @id @default(autoincrement())
  staffId     Int       @map("staff_id")
  staff       AdminUser @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date        DateTime
  status      String    @default("Present") // Present, Absent, Half-day, Leave, Holiday
  checkIn     DateTime? @map("check_in")
  checkOut    DateTime? @map("check_out")
  workHours   Float?    @map("work_hours")
  notes       String?
  markedBy    String?   @map("marked_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([staffId, date])
  @@index([staffId, date])
}

model LeaveRequest {
  id          Int       @id @default(autoincrement())
  staffId     Int       @map("staff_id")
  staff       AdminUser @relation(fields: [staffId], references: [id], onDelete: Cascade)
  leaveType   String    @default("Casual") // Casual, Sick, Earned, Unpaid, Maternity
  startDate   DateTime  @map("start_date")
  endDate     DateTime  @map("end_date")
  days        Int       @default(1)
  reason      String?
  status      String    @default("Pending") // Pending, Approved, Rejected
  approvedBy  String?   @map("approved_by")
  approvedAt  DateTime? @map("approved_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([staffId])
  @@index([status])
}

// =====================================================
// VISITOR TRACKING — customer insights
// =====================================================

model Visitor {
  id          Int      @id @default(autoincrement())
  ip          String?
  city        String?
  region      String?
  country     String?
  timezone    String?
  device      String?
  page        String?
  userAgent   String?  @map("user_agent")
  referrer    String?
  localTime   String?  @map("local_time")
  sessionId   String?  @map("session_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([ip])
  @@index([city])
}
