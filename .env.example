# ============================================================
# ParcelMaadi — Environment Variables for Vercel Deployment
# ============================================================
# Copy these to Vercel → Settings → Environment Variables

# ─── DATABASE (REQUIRED for production) ───
# Use Supabase, Neon, or any PostgreSQL provider (FREE tier works)
# Supabase: https://supabase.com → New Project → Settings → Database → Connection string
# Neon: https://neon.tech → New Project → Connection string
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.XXXXXX.supabase.co:5432/postgres?schema=public"

# ─── SESSION SECRET (REQUIRED) ───
# Generate with: openssl rand -base64 32
SESSION_SECRET="CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING"

# ─── NEXTAUTH (if using NextAuth.js) ───
NEXTAUTH_SECRET="CHANGE_ME_TO_ANOTHER_RANDOM_STRING"
NEXTAUTH_URL="https://your-domain.vercel.app"

# ─── NODE ENV ───
NODE_ENV="production"

# ─── BRAND INFO ───
COMPANY_NAME="HP Enterprise"
BRAND_NAME="ParcelMaadi"
GSTIN="29ANZPH4067Q1ZS"
WEBSITE_URL="https://parcelmaadi.com"

# ─── NOTIFICATIONS (free — ntfy + Telegram) ───
NTFY_TOPIC="parcelmaadi-admin-x7k9m2"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ─── WHATSAPP (deep link — no API key needed) ───
WHATSAPP_NUMBER="919741433725"

# ─── RAZORPAY (for online payments — optional) ───
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ─── ADMIN CREDENTIALS ───
ADMIN_EMAIL="admin@parcelmaadi.com"
